#!/usr/bin/env ruby
require "fileutils"
require "socket"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

# Fail with an explanation instead of a page of ActiveRecord backtraces when the
# database is not reachable yet. bin/rails db:prepare would otherwise be the
# first thing to touch the database and dump its connection error.
def check_database_connection!
  host = ENV.fetch("PGHOST", "localhost")
  port = Integer(ENV.fetch("PGPORT", 5432))

  Socket.tcp(host, port, connect_timeout: 2, &:close)
rescue StandardError
  STDOUT.flush
  abort <<~MESSAGE
    == Cannot reach PostgreSQL at #{host}:#{port} ==

    Start PostgreSQL and run bin/setup again. For example:

        docker start <your-postgres-container>   # if you use Docker
        sudo systemctl start postgresql          # if you installed it natively

    If your host, port, or credentials differ, export them first:

        export PGHOST=localhost PGPORT=5432 PGUSER=postgres PGPASSWORD=postgres
  MESSAGE
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  puts "\n== Checking database connection =="
  check_database_connection!

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
